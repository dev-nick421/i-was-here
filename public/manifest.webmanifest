{
  "id": "/",
  "name": "I Was Here: map poster studio",
  "short_name": "I Was Here",
  "description": "Design minimalist map posters of any place on earth and export them as print-ready images.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#e2ddd2",
  "theme_color": "#fbf9f4",
  "categories": ["design", "graphics", "photo", "travel"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    {
      "src": "/screenshots/editor-wide.jpg",
      "sizes": "1600x1000",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "The poster editor with styles, typefaces and print settings"
    },
    {
      "src": "/screenshots/editor-narrow.jpg",
      "sizes": "824x1830",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Designing a poster on a phone"
    },
    {
      "src": "/screenshots/styles-narrow.jpg",
      "sizes": "824x1830",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Picking a palette"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": { "application/json": [".json"] },
      "launch_type": "single-client"
    }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "prefer_related_applications": false
}

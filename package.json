{
  "name": "i-was-here",
  "version": "1.0.0",
  "description": "Design minimalist map posters of any place on earth and export them as print-ready high-resolution images. Open source, self-hostable.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": "Nicklas Eßer",
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-nick421/i-was-here.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures:serve": "node tests/fixtures/server.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",

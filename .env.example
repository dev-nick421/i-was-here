# Copy to .env and adjust. Every variable is optional.

# --- Map data -----------------------------------------------------------------
# Vector tiles in the OpenMapTiles schema. Either a TileJSON URL or a tile URL template
# like https://example.org/tiles/{z}/{x}/{y}.pbf
NUXT_PUBLIC_MAP_TILES_URL=https://tiles.openfreemap.org/planet
# Glyphs (fonts) for the optional district labels
NUXT_PUBLIC_MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
# Font stack used for labels (must exist on the glyph server)
NUXT_PUBLIC_MAP_LABEL_FONT=Noto Sans Regular
# Credit line printed on posters (required by the data licenses)
NUXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors · © OpenMapTiles
# Shown in the editor footer
NUXT_PUBLIC_MAP_PROVIDER_NAME=OpenFreeMap
NUXT_PUBLIC_MAP_PROVIDER_URL=https://openfreemap.org

# --- Place search ---------------------------------------------------------------
# "photon" (komoot, supports search-as-you-type) or "nominatim" (throttled to 1 req/s)
NUXT_GEOCODER_PROVIDER=photon
# Custom endpoint, e.g. a self-hosted Photon: https://photon.example.org/api/
NUXT_GEOCODER_URL=
# Sent as User-Agent to the geocoder. Please identify your instance.
NUXT_GEOCODER_USER_AGENT=i-was-here/1.0 (+https://github.com/dev-nick421/i-was-here)
# Contact e-mail sent to Nominatim (recommended by its usage policy)
NUXT_GEOCODER_EMAIL=
NUXT_GEOCODER_TIMEOUT_MS=8000
# Max. place searches per IP and minute (0 disables the limit)
NUXT_GEOCODER_RATE_LIMIT=120

# --- Server ---------------------------------------------------------------------
# With docker compose: the port on your host (the container always listens on 3000).
# Without Docker (node .output/server/index.mjs): the port the server listens on.
PORT=3000
HOST=0.0.0.0
